<header class="site-header">
  <a class="site-name" href="<%= url_for('/') %>" aria-label="返回<%= config.title %>首页">
    <span class="site-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <circle cx="16" cy="16" r="5" />
        <path d="M16 4v4M16 24v4M4 16h4M24 16h4M7.5 7.5l2.8 2.8M21.7 21.7l2.8 2.8M24.5 7.5l-2.8 2.8M10.3 21.7l-2.8 2.8" />
      </svg>
    </span>
    <span><%= config.author %></span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    <a href="<%= url_for('/') %>"<% if (is_home()) { %> aria-current="page"<% } %>>首页</a>
    <a href="<%= url_for('/categories/life/') %>"<% if (is_category('生活思考')) { %> aria-current="page"<% } %>>生活思考</a>
    <a href="<%= url_for('/categories/knowledge/') %>"<% if (is_category('专业知识')) { %> aria-current="page"<% } %>>专业知识</a>
    <a href="<%= url_for('/archives/') %>"<% if (is_archive()) { %> aria-current="page"<% } %>>归档</a>
    <a href="<%= url_for('/about/') %>"<% if (page.path === 'about/index.html') { %> aria-current="page"<% } %>>关于</a>
    <% if (theme.notion_url) { %>
      <a href="<%= theme.notion_url %>" target="_blank" rel="noopener noreferrer">Notion<span aria-hidden="true"> ↗</span></a>
    <% } %>
  </nav>
</header>
