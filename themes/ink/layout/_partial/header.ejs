<header class="site-header">
  <a class="site-name" href="<%= url_for('/') %>" aria-label="返回首页">
    <span class="site-mark" aria-hidden="true">M</span>
    <span><%= config.title %></span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    <a href="<%= url_for('/') %>"<% if (is_home()) { %> aria-current="page"<% } %>>首页</a>
    <a href="<%= url_for('/archives/') %>"<% if (is_archive()) { %> aria-current="page"<% } %>>归档</a>
    <a href="<%= url_for('/about/') %>"<% if (page.path === 'about/index.html') { %> aria-current="page"<% } %>>关于</a>
    <% if (theme.notion_url) { %>
      <a href="<%= theme.notion_url %>" target="_blank" rel="noopener noreferrer">Notion<span aria-hidden="true"> ↗</span></a>
    <% } %>
  </nav>
</header>
