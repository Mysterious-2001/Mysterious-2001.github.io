<article class="article">
  <header class="article-header">
    <p class="eyebrow"><%= page.categories && page.categories.length ? page.categories.last().name : '文章' %></p>
    <h1><%= page.title %></h1>
    <div class="article-meta">
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY年MM月DD日') %></time>
      <% if (page.updated && date(page.updated, 'YYYY-MM-DD') !== date(page.date, 'YYYY-MM-DD')) { %>
        <span>更新于 <%= date(page.updated, 'YYYY年MM月DD日') %></span>
      <% } %>
    </div>
  </header>

  <div class="article-content">
    <%- page.content %>
  </div>

  <% if (page.tags && page.tags.length) { %>
    <footer class="article-tags" aria-label="文章标签">
      <% page.tags.each(function(tag) { %>
        <a href="<%= url_for(tag.path) %>">#<%= tag.name %></a>
      <% }); %>
    </footer>
  <% } %>
</article>

<nav class="post-nav" aria-label="相邻文章">
  <% if (page.prev) { %>
    <a class="post-nav-item" href="<%= url_for(page.prev.path) %>">
      <span>上一篇</span>
      <strong><%= page.prev.title %></strong>
    </a>
  <% } %>
  <% if (page.next) { %>
    <a class="post-nav-item post-nav-next" href="<%= url_for(page.next.path) %>">
      <span>下一篇</span>
      <strong><%= page.next.title %></strong>
    </a>
  <% } %>
</nav>
